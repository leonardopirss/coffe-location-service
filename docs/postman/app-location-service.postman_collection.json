  "item": [
    {
      "name": "App - Users",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) {}",
                  "const token = body.token || body.jwtToken || body.accessToken || body.access_token;",
                  "if (token) {",
                  "  pm.environment.set('jwt_token', token);",
                  "  pm.collectionVariables.set('jwt_token', token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@app-location.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "Autentica usuario e salva automaticamente o JWT em `jwt_token` quando a resposta possuir `token`, `jwtToken`, `accessToken` ou `access_token`."
          },
          "response": []
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@app-location.com\",\n  \"password\": \"123456\",\n  \"role\": \"ROLE_CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/create",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "create"
              ]
            }
          },
          "response": []
        }
      ]
    },
